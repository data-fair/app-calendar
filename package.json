{
  "name": "@data-fair/app-calendar",
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "df-dev-env && dotenv -- zellij --layout .zellij.kdl",
    "dev-app": "vite",
    "dev-server": "df-dev-server",
    "build": "PUBLIC_URL=https://cdn.jsdelivr.net/npm/@data-fair/app-calendar@${npm_package_version}/dist vite build",
    "build-test": "PUBLIC_URL=https://staging-koumoul.com/apps/calendar/master/ vite build",
    "build-types": "df-build-types && cp src/config/.type/resolved-schema.json public/config-schema.json",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare": "husky || true",
    "type-check": "vue-tsc --noEmit",
    "test": "npm run test-unit && df-dev-env && dotenv -- playwright test --max-failures=1",
    "test-unit": "vitest run",
    "test-e2e": "df-dev-env && dotenv -- playwright test",
    "quality": "npm run lint && npm run build-types && npm run type-check && npm run build && npm test && npm audit --omit=dev --audit-level=critical"
  },
  "files": [
    "dist"
  ],
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "dependencies": {
    "@data-fair/frame": "^0.18.5",
    "@data-fair/lib-utils": "^1.10.2",
    "@data-fair/lib-vue": "^1.27.2",
    "@data-fair/lib-vuetify": "^2.3.0",
    "@koumoul/vjsf": "^4.3.1",
    "@koumoul/vjsf-markdown": "^0.5.1",
    "@vueuse/core": "^14.4.0",
    "@wojtekmaj/opening-hours-utils": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "chroma-js": "^3.2.0",
    "dayjs": "^1.11.13",
    "ofetch": "^1.3.4",
    "vue": "^3.4.29",
    "vue-i18n": "^11.4.10",
    "vuetify": "^4.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@data-fair/dev-server": "^2.5.0",
    "@data-fair/lib-types-builder": "^1.12.0",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.61.1",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.11",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.2.0",
    "eslint-plugin-vuetify": "^2.5.2",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "neostandard": "^0.13.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.77.6",
    "sass-embedded": "^1.103.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.2.7"
  }
}
