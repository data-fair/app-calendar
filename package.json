{
  "name": "@data-fair/app-calendar",
  "version": "1.2.12",
  "type": "module",
  "scripts": {
    "dev": "zellij --layout .zellij.kdl",
    "dev-app": "vite --port 3000",
    "dev-server": "cross-env APP_URL=http://localhost:3000/app/ df-dev-server",
    "build": "PUBLIC_URL=https://cdn.jsdelivr.net/npm/@data-fair/app-calendar@${npm_package_version}/dist vite build",
    "build-test": "PUBLIC_URL=https://staging-koumoul.com/apps/calendar/master/ vite build",
    "build-types": "df-build-types && ncp src/config/.type/resolved-schema.json public/config-schema.json",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "type-check": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:webserver": "vite --port 4100 --strictPort"
  },
  "files": [
    "dist"
  ],
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "dependencies": {
    "@data-fair/frame": "^0.18.5",
    "@data-fair/lib-utils": "^1.10.2",
    "@data-fair/lib-vue": "^1.27.2",
    "@data-fair/lib-vuetify": "^2.3.0",
    "@koumoul/vjsf": "^4.3.1",
    "@koumoul/vjsf-markdown": "^0.5.1",
    "@vueuse/core": "^10.7.2",
    "@wojtekmaj/opening-hours-utils": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "chroma-js": "^2.4.2",
    "dayjs": "^1.11.13",
    "ofetch": "^1.3.4",
    "reconnecting-websocket": "^4.4.0",
    "vue": "^3.4.29",
    "vuetify": "^4.0.6"
  },
  "devDependencies": {
    "@data-fair/dev-server": "^2.1.0",
    "@data-fair/lib-types-builder": "^1.12.0",
    "@playwright/test": "^1.61.1",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.2.0",
    "eslint-plugin-vuetify": "^2.5.2",
    "ncp": "^2.0.0",
    "neostandard": "^0.13.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.77.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.2.7"
  }
}
