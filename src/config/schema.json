{
  "type": "object",
  "x-exports": [
    "types",
    "resolvedSchemaJson"
  ],
  "required": ["datasets"],
  "allOf": [
    {
      "title": "Source de données",
      "properties": {
        "datasets": {
          "type": "array",
          "items": [
            {
              "title": "Jeu de données",
              "description": "Ce jeu doit contenir au moins un champ avec le concept de date",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "href": {
                  "type": "string" 
                },
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "isRest": {
                  "type": "boolean"
                },
                "schema": {
                  "type": "array"
                },
                "timePeriod": {
                  "type": "object"
                },
                "attachmentsAsImage": {
                  "type": "boolean"
                },
                "userPermissions": {
                  "type": "array"
              },
                "finalizedAt": {
                  "type": "string"
                }
              },
              "layout": {
                "getItems": {
                  "url": "api/v1/datasets?status=finalized&q={q}&select=title,isRest,schema,timePeriod,attachmentsAsImage,userPermissions&${context.datasetFilter}&short-concept=date,startDate,endDate&size=50&sort=createdAt:-1",
                  "itemsResults": "data.results",
                  "itemTitle": "item.title",
                  "itemKey": "item.href"
                }
              }
            }
          ]
        },
        "staticFilters": {
          "title": "Filtres prédéfinis",
          "type": "array",
          "items": {
            "type": "object",
            "default": { "type": "in" },
            "discriminator": { "propertyName": "type" },
            "oneOfLayout": { "label": "Type de filtre" },
            "oneOf": [
              {
                "title": "Restreindre à des valeurs",
                "required": ["type", "field", "values"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "in" },
                  "field": {
                    "type": "string",
                    "title": "Colonne de filtre",
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/schema?calculated=false",
                        "itemKey": "data[\"key\"]",
                        "itemTitle": "data[\"label\"]"
                      }
                    }
                  },
                  "values": {
                    "type": "array",
                    "title": "Valeurs",
                    "items": { "type": "string" },
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/values-labels/${parent.data.field}?q={q}&q_mode=complete&size=100&stringify=true",
                        "itemKey": "data[\"value\"]",
                        "itemTitle": "data[\"label\"]"
                      }
                    }
                  }
                }
              },
              {
                "title": "Restreindre à un intervalle de valeurs",
                "required": ["type", "field"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "interval" },
                  "field": {
                    "type": "string",
                    "title": "Colonne de filtre",
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/schema?calculated=false",
                        "itemKey": "data[\"key\"]",
                        "itemTitle": "data[\"label\"]"
                      }
                    }
                  },
                  "minValue": {
                    "type": "string",
                    "title": "Valeur min",
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/values-labels/${parent.data.field}?sort=asc&${parent.data.field}_gte={q}&size=100&stringify=true",
                        "itemKey": "data[\"value\"]",
                        "itemTitle": "data[\"label\"]"
                      }
                    }
                  },
                  "maxValue": {
                    "type": "string",
                    "title": "Valeur max",
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/values-labels/${parent.data.field}?sort=desc&${parent.data.field}_lte={q}&size=100&stringify=true",
                        "itemKey": "data[\"value\"]",
                        "itemTitle": "data[\"label\"]"
                      }
                    }
                  }
                }
              },
              {
                "title": "Exclure des valeurs",
                "required": ["type", "field", "values"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "out" },
                  "field": {
                    "type": "string",
                    "title": "Colonne de filtre",
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/schema?calculated=false",
                        "itemKey": "data[\"key\"]",
                        "itemTitle": "data[\"label\"]"
                      }
                    }
                  },
                  "values": {
                    "type": "array",
                    "title": "Valeurs à exclure",
                    "items": { "type": "string" },
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/values-labels/${parent.data.field}?q={q}&q_mode=complete&size=100&stringify=true",
                        "itemKey": "data[\"value\"]",
                        "itemTitle": "data[\"label\"]"
                      }
                    }
                  }
                }
              },
              {
                "title": "Commence par",
                "required": ["type", "field", "value"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "starts" },
                  "field": {
                    "type": "string",
                    "title": "Colonne de filtre",
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/schema?calculated=false",
                        "itemKey": "data[\"key\"]",
                        "itemTitle": "data[\"label\"]"
                      }
                    }
                  },
                  "value": {
                    "type": "string",
                    "title": "Valeur"
                  }
                }
              },
              {
                "title": "Exclure les valeurs vides ou non définies",
                "required": ["type", "field"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "exists" },
                  "field": {
                    "type": "string",
                    "title": "Colonne de filtre",
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/schema?calculated=false",
                        "itemKey": "data[\"key\"]",
                        "itemTitle": "data[\"label\"]"
                      }
                    }
                  }
                }
              },
              {
                "title": "Restreindre aux valeurs vides ou non définies",
                "required": ["type", "field"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "notExists" },
                  "field": {
                    "type": "string",
                    "title": "Colonne de filtre",
                    "layout": {
                      "getItems": {
                        "url": "${rootData.datasets[0].href}/schema?calculated=false",
                        "itemKey": "data[\"key\"]",
                        "itemTitle": "data[\"label\"]"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "title": "Affichage",
      "description": "Gérer l'affichage du calendrier",
      "properties": {
        "labelField": {
          "type": "object",
          "title": "Champ de libellé",
          "description": "Choisissez le champ représentant le libellé d'un événement.",
          "properties": {
            "key": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          },
          "layout": {
            "getItems": {
                "url": "${rootData.datasets[0].href}/schema?calculated=false",
                "itemKey": "data[\"key\"]",
                "itemTitle": "data[\"label\"]"
            }
          }
        },
        "openOnCurrentDay": {
          "type": "boolean",
          "title": "Afficher initial à la date du jour",
          "default": false
        },
        "initialView": {
          "title": "Vue initiale",
          "type": "string",
          "oneOf": [
            {
              "const": "month",
              "title": "Mois"
            },
            {
              "const": "week",
              "title": "Semaine"
            },
            {
              "const": "day",
              "title": "Jour"
            },
            {
              "const": "planning",
              "title": "Planning"
            }
          ],
          "default": "month"
        },
        "color": {
          "type": "object",
          "title": "Réglage des couleurs",
          "required": ["type"],
          "discriminator": { "propertyName": "type" },
          "oneOfLayout": { "label": "Mode de couleurs" },
          "oneOf": [
            {
              "title": "Calendrier multicolore",
              "additionalProperties": false,
              "required": ["field"],
              "properties": {
                "type": {
                  "const": "multicolor"
                },
                "field": {
                  "type": "string",
                  "title": "Champ de catégorie",
                  "description": "Choisissez le champ permettant de distinguer les catégories d'événements suivant des couleurs distinctes.",
                  "layout": {
                    "getItems": {
                      "url": "${rootData.datasets[0].href}/schema?calculated=false&maxCardinality=12",
                      "itemKey": "data[\"key\"]",
                      "itemTitle": "data[\"label\"]"
                    }
                  }
                },
                "colors": {
                  "type": "object",
                  "title": "Couleurs",
                  "discriminator": { "propertyName": "type" },
                  "oneOfLayout": { "label": "Type de palette" },
                  "oneOf": [
                    {
                      "title": "Palette précalculée",
                      "required": ["type", "name"],
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "palette"
                        },
                        "name": {
                          "title": "Palette",
                          "type": "string",
                          "oneOf": [
                            {
                              "const": "Accent",
                              "title": "Accent"
                            },
                            {
                              "const": "Dark2",
                              "title": "Foncé"
                            },
                            {
                              "const": "Paired",
                              "title": "Paires"
                            },
                            {
                              "const": "Set1",
                              "title": "Ensemble 1"
                            },
                            {
                              "const": "Set2",
                              "title": "Ensemble 2"
                            },
                            {
                              "const": "Set3",
                              "title": "Ensemble 3"
                            },
                            {
                              "const": "Pastel1",
                              "title": "Pastel 1"
                            },
                            {
                              "const": "Pastel2",
                              "title": "Pastel 2"
                            }
                          ],
                          "default": "Accent"
                        },
                        "offset": {
                          "type": "integer",
                          "title": "Décalage",
                          "default": 0
                        }
                      }
                    },
                    {
                      "title": "Palette personnalisée",
                      "required": ["type", "categories"],
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "manual"
                        },
                        "categories": {
                          "title": "Couleurs",
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["value"],
                            "additionalProperties": false,
                            "properties": {
                              "value": {
                                "type": "string",
                                "title": "Valeur",
                                "layout": {
                                  "comp": "select",
                                  "getItems": {
                                    "url": "${rootData.datasets[0].href}/values_agg?field=${rootData.color.field}&size=0&agg_size=15",
                                    "itemKey": "item.value",
                                    "itemTitle": "item.value",
                                    "itemsResults": "data.aggs.map(a => ({ value: a.value }))"
                                  }
                                }
                              },
                              "color": {
                                "$ref": "#/definitions/hexColor"
                              }
                            }
                          }
                        }
                      }
                    }
                  ],
                  "default": {
                    "type": "palette",
                    "name": "Accent",
                    "offset": 0
                  }
                }
              }
            },
            {
              "title": "Calendrier monochrome",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "monochrome"
                },
                "colors": {
                  "type": "object",
                  "title": "Couleur",
                  "required": ["type"],
                  "discriminator": { "propertyName": "type" },
                  "oneOfLayout": { "label": "Mode de couleur" },
                  "oneOf": [
                    {
                      "title": "Thème",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "theme"
                        },
                        "strValue": {
                          "title": "Couleur",
                          "type": "string",
                          "oneOf": [
                            {
                              "const": "primary",
                              "title": "Primaire"
                            },
                            {
                              "const": "secondary",
                              "title": "Secondaire"
                            },
                            {
                              "const": "accent",
                              "title": "Accent"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "title": "Personnalisée",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "custom"
                        },
                        "hexValue": {
                          "$ref": "#/definitions/hexColor"
                        }
                      }
                    }
                  ],
                  "default": {
                    "type": "theme",
                    "strValue": "primary"
                  }
                }
              }
            }
          ],
          "default": {
            "type": "monochrome"
          }
        }
      }
    },
    {
      "title": "Détails d'un événement",
      "description": "Gérer le contenu de l'affichage lors du clic sur un événement",
      "properties": {
        "descriptionField": {
          "type": "object",
          "title": "Champ de description",
          "description": "Choisissez le champ permettant de fournir une description de l'événement, interprète le html et le markdown.",
          "properties": {
            "key": {
              "type": "string"
            }
          },
          "layout": {
            "getItems": {
              "url": "${rootData.datasets[0].href}/schema?calculated=false",
              "itemKey": "data[\"key\"]",
              "itemTitle": "data[\"label\"]"
            }
          }
        },
        "additionalFields": {
          "title": "Champs supplémentaires à afficher",
          "type": "array",
          "items": { "type": "string" },
          "layout": {
            "props": { "chips": true, "closableChips": true },
            "getItems": {
              "url": "${rootData.datasets[0].href}/schema?calculated=false",
              "itemKey": "data[\"key\"]",
              "itemTitle": "data[\"label\"]"
            }
          }
        },
        "imageWidth": {
          "title": "Largeur de l'image en % de la fiche",
          "type": "number",
          "default": 100,
          "minimum": 20,
          "maximum": 100,
          "layout": {
            "comp": "slider",
            "step": 1,
            "label": "",
            "slots": { "before": "Largeur de l'image en % de la fiche" },
            "props": { "showTicks": "always", "thumbLabel": true }
          }
        },
        "aspectRatio": {
          "title": "Rapport de forme (largeur / hauteur)",
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 5,
          "layout": {
            "comp": "slider",
            "step": 0.1,
            "label": "",
            "slots": { "before": "Rapport de forme (largeur / hauteur)" },
            "props": { "showTicks": "always", "thumbLabel": true }
          }
        },
        "imagePosition": {
          "title": "Position de l'image",
          "description": "Ne change rien si la largeur de l'image est 100% de la fiche",
          "type": "string",
          "oneOf": [
            {
              "const": "top",
              "title": "En haut"
            },
            {
              "const": "left",
              "title": "À gauche"
            },
            {
              "const": "right",
              "title": "À droite"
            }
          ],
          "default": "top"
        },
        "imageDisplay": {
          "title": "Rendu de l'image",
          "type": "string",
          "oneOf": [
            {
              "const": "cover",
              "title": "Étendre"
            },
            {
              "const": "contain",
              "title": "Redimensionner"
            }
          ],
          "default": "cover"
        }
      }
    }
  ],
  "if": {
    "properties": {
      "datasets": {
        "type": "array",
        "minItems": 1,
        "contains": {
          "type": "object",
          "required": ["isRest"],
          "properties": {
            "isRest": { "const": true }
          }
        }
      }
    }
  },
  "then": {
    "title": "Edition",
    "properties": {
        "formWidth": {
          "title": "Largeur du formulaire",
          "type": "integer",
          "layout": {
            "comp": "slider",
            "step": 1,
            "label": "",
            "slots": { "before": "Largeur du formulaire" },
            "props": { "showTicks": "always", "thumbLabel": true }
          },
          "minimum": 2,
          "maximum": 10,
          "default": 5
        },
        "minDate": {
          "title": "Valeur minimale pour la date de début",
          "description": "Bloque le déplacement, le redimensionnement et la création d'événements avant cette date. La contrainte n'est pas appliquée dans le formulaire de modification (limitation de l'iframe data-fair).",
          "type": "string",
          "oneOf": [
            {
              "const": "none",
              "title": "Pas de contrainte"
            },
            {
              "const": "day",
              "title": "Date du jour"
            },
            {
              "const": "tomorrow",
              "title": "Lendemain de la date du jour"
            },
            {
              "const": "one-week-later",
              "title": "Une semaine après la date du jour"
            },
            {
              "const": "one-month-later",
              "title": "Un mois après la date du jour"
            }
          ],
          "default": "none"
        },
        "maxDate": {
          "title": "Valeur maximale pour la date de fin",
          "description": "Bloque le déplacement, le redimensionnement et la création d'événements après cette date. La contrainte n'est pas appliquée dans le formulaire de modification (limitation de l'iframe data-fair).",
          "type": "string",
          "oneOf": [
            {
              "const": "none",
              "title": "Pas de contrainte"
            },
            {
              "const": "one-week-later",
              "title": "Une semaine après la date du jour"
            },
            {
              "const": "one-month-later",
              "title": "Un mois après la date du jour"
            },
            {
              "const": "one-year-later",
              "title": "Un an après la date du jour"
            }
          ],
          "default": "none"
        }
      }
  },
  "definitions": {
    "hexColor": {
      "type": "string",
      "title": "Couleur",
      "default": "#828282",
      "layout": "color-picker"
    }
  }
}
